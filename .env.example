PORT=3001
DATABASE_PATH=./data/revivepay.db
PUBLIC_APP_URL=http://localhost:3001

# Optional: real Razorpay test-mode execution. Without these, the safe demo adapter is used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Preferred: OpenRouter free-model routing for AI reply classification.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional secondary provider. A deterministic fallback always remains available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
