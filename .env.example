PORT=3001
DATABASE_PATH=./data/revivepay.db
PUBLIC_APP_URL=http://localhost:3001

# Optional: real Razorpay test-mode execution. Without these, the safe demo adapter is used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: AI reply classification. A deterministic fallback keeps the demo operational.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

